# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# ============================================================================
# RAZORPAY UPI QR & PAYMENT CONFIGURATION (Server-Side Secrets Only)
# ============================================================================
# Razorpay API Key ID (Test mode starts with rzp_test_..., Live starts with rzp_live_...)
RAZORPAY_KEY_ID=""
# Razorpay API Key Secret (NEVER expose in frontend)
RAZORPAY_KEY_SECRET=""
# Razorpay Webhook Secret configured in Razorpay Dashboard -> Webhooks
# Webhook endpoint: <APP_URL>/api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=""

# ============================================================================
# TRANSACTIONAL EMAIL NOTIFICATIONS (SMTP or Resend API)
# ============================================================================
# Administrator Email to receive new booking notifications (configurable in Admin Settings)
ADMINISTRATOR_EMAIL=""
# Option A: Resend HTTP API Key (https://resend.com)
RESEND_API_KEY=""
# Option B: Standard SMTP Server (e.g., Gmail App Password, AWS SES, Postmark, SendGrid)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Ram Ashok Kumar Consultations <no-reply@ramashokkumar.com>"

# ============================================================================
# OPTIONAL SUPABASE POSTGRESQL MIRROR (If using external Supabase instance)
# ============================================================================
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
