rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'eklavyas10@gmail.com' ||
        request.auth.token.email == 'ramashokkumar@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Validation Blueprint: AdminUser
    function isValidAdminUser(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'createdAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
        data.createdAt is timestamp;
    }

    // Validation Blueprint: AdminSettings
    function isValidAdminSettings(data) {
      return data.keys().hasAll([
          'administrator_email',
          'business_timezone',
          'booking_advance_days',
          'phone_consultation_price',
          'in_person_consultation_price',
          'appointment_duration',
          'operating_start_time',
          'operating_end_time',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'administrator_email',
          'business_timezone',
          'booking_advance_days',
          'phone_consultation_price',
          'in_person_consultation_price',
          'appointment_duration',
          'operating_start_time',
          'operating_end_time',
          'updatedAt'
        ]) &&
        data.administrator_email is string && data.administrator_email.size() >= 3 && data.administrator_email.size() <= 254 &&
        data.business_timezone is string && data.business_timezone.size() >= 2 && data.business_timezone.size() <= 64 &&
        data.booking_advance_days is int && data.booking_advance_days >= 1 && data.booking_advance_days <= 365 &&
        data.phone_consultation_price is int && data.phone_consultation_price >= 100 && data.phone_consultation_price <= 500000 &&
        data.in_person_consultation_price is int && data.in_person_consultation_price >= 100 && data.in_person_consultation_price <= 500000 &&
        data.appointment_duration is int && data.appointment_duration >= 15 && data.appointment_duration <= 240 &&
        data.operating_start_time is string && data.operating_start_time.size() >= 4 && data.operating_start_time.size() <= 10 &&
        data.operating_end_time is string && data.operating_end_time.size() >= 4 && data.operating_end_time.size() <= 10 &&
        data.updatedAt is timestamp;
    }

    // Validation Blueprint: AvailabilitySlot
    function isValidAvailabilitySlot(data) {
      return data.keys().hasAll([
          'date',
          'start_time',
          'end_time',
          'is_available',
          'block_reason',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'date',
          'start_time',
          'end_time',
          'is_available',
          'block_reason',
          'createdAt',
          'updatedAt'
        ]) &&
        data.date is string && data.date.size() == 10 && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.start_time is string && data.start_time.size() >= 4 && data.start_time.size() <= 20 &&
        data.end_time is string && data.end_time.size() >= 4 && data.end_time.size() <= 20 &&
        data.is_available is bool &&
        data.block_reason is string && data.block_reason.size() <= 500 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Validation Blueprint: Appointment
    function isValidAppointment(data) {
      return data.keys().hasAll([
          'booking_reference',
          'customer_name',
          'customer_email',
          'customer_phone',
          'customer_address',
          'appointment_type',
          'appointment_price',
          'appointment_date',
          'start_time',
          'end_time',
          'timezone',
          'consultation_reason',
          'additional_message',
          'appointment_status',
          'payment_status',
          'payment_reference',
          'admin_notes',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'booking_reference',
          'customer_name',
          'customer_email',
          'customer_phone',
          'customer_address',
          'appointment_type',
          'appointment_price',
          'appointment_date',
          'start_time',
          'end_time',
          'timezone',
          'consultation_reason',
          'additional_message',
          'appointment_status',
          'payment_status',
          'payment_reference',
          'admin_notes',
          'createdAt',
          'updatedAt'
        ]) &&
        data.booking_reference is string && data.booking_reference.size() >= 6 && data.booking_reference.size() <= 40 && data.booking_reference.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.customer_name is string && data.customer_name.size() >= 2 && data.customer_name.size() <= 120 &&
        data.customer_email is string && data.customer_email.size() >= 3 && data.customer_email.size() <= 254 &&
        data.customer_phone is string && data.customer_phone.size() >= 7 && data.customer_phone.size() <= 24 &&
        data.customer_address is string && data.customer_address.size() >= 5 && data.customer_address.size() <= 600 &&
        (
          (data.appointment_type == 'phone_consultation' && data.appointment_price == 5100) ||
          (data.appointment_type == 'in_person_consultation' && data.appointment_price == 11000)
        ) &&
        data.appointment_date is string && data.appointment_date.size() == 10 && data.appointment_date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.start_time is string && data.start_time.size() >= 4 && data.start_time.size() <= 20 &&
        data.end_time is string && data.end_time.size() >= 4 && data.end_time.size() <= 20 &&
        data.timezone is string && data.timezone.size() >= 2 && data.timezone.size() <= 64 &&
        data.consultation_reason is string && data.consultation_reason.size() >= 5 && data.consultation_reason.size() <= 2500 &&
        data.additional_message is string && data.additional_message.size() <= 2000 &&
        data.appointment_status in ['Pending Payment', 'Confirmed', 'Completed', 'Cancelled', 'Expired'] &&
        data.payment_status in ['Pending', 'Paid', 'Failed', 'Expired', 'Refunded'] &&
        data.payment_reference is string && data.payment_reference.size() <= 128 &&
        (data.payment_status != 'Paid' || data.payment_reference.size() >= 4) &&
        data.admin_notes is string && data.admin_notes.size() <= 4000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Validation Blueprint: PaymentRecord
    function isValidPaymentRecord(data) {
      return data.keys().hasAll([
          'appointment_id',
          'provider',
          'provider_payment_id',
          'provider_qr_id',
          'amount',
          'currency',
          'payment_method',
          'payment_status',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'appointment_id',
          'provider',
          'provider_payment_id',
          'provider_qr_id',
          'amount',
          'currency',
          'payment_method',
          'payment_status',
          'createdAt',
          'updatedAt'
        ]) &&
        data.appointment_id is string && data.appointment_id.size() >= 1 && data.appointment_id.size() <= 128 && data.appointment_id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.provider == 'razorpay' &&
        data.provider_payment_id is string && data.provider_payment_id.size() <= 128 &&
        data.provider_qr_id is string && data.provider_qr_id.size() >= 1 && data.provider_qr_id.size() <= 128 &&
        data.amount is int && (data.amount == 5100 || data.amount == 11000) &&
        data.currency == 'INR' &&
        data.payment_method == 'UPI' &&
        data.payment_status in ['Pending', 'Paid', 'Failed', 'Expired', 'Refunded'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Collection 1: /admins/{adminUid}
    match /admins/{adminUid} {
      allow get: if isSignedIn() && isValidId(adminUid) && (request.auth.uid == adminUid || isAdmin());
      allow list: if isAdmin() && resource.data.uid is string;
      allow create: if isAdmin() && isValidId(adminUid) && isValidAdminUser(incoming()) &&
        incoming().uid == adminUid &&
        incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin() && isValidId(adminUid);
    }

    // Collection 2: /admin_settings/{settingId}
    match /admin_settings/{settingId} {
      allow get: if isAdmin() && isValidId(settingId);
      allow list: if isAdmin() && resource.data.business_timezone is string;
      allow create: if isAdmin() && isValidId(settingId) && isValidAdminSettings(incoming()) &&
        incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(settingId) && isValidAdminSettings(incoming()) &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'administrator_email',
          'business_timezone',
          'booking_advance_days',
          'phone_consultation_price',
          'in_person_consultation_price',
          'appointment_duration',
          'operating_start_time',
          'operating_end_time',
          'updatedAt'
        ]);
      allow delete: if false;
    }

    // Collection 3: /availability/{slotId}
    match /availability/{slotId} {
      allow get: if isAdmin() && isValidId(slotId);
      allow list: if isAdmin() && resource.data.date is string;
      allow create: if isAdmin() && isValidId(slotId) && isValidAvailabilitySlot(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(slotId) && isValidAvailabilitySlot(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().date == existing().date &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'start_time',
          'end_time',
          'is_available',
          'block_reason',
          'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(slotId);
    }

    // Collection 4: /appointments/{appointmentId}
    match /appointments/{appointmentId} {
      allow get: if isAdmin() && isValidId(appointmentId);
      allow list: if isAdmin() && resource.data.booking_reference is string;
      allow create: if isAdmin() && isValidId(appointmentId) && isValidAppointment(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(appointmentId) && isValidAppointment(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().booking_reference == existing().booking_reference &&
        incoming().appointment_type == existing().appointment_type &&
        incoming().appointment_price == existing().appointment_price &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'appointment_status',
          'payment_status',
          'payment_reference',
          'admin_notes',
          'updatedAt'
        ]);
      allow delete: if false;
    }

    // Collection 5: /payments/{paymentId}
    match /payments/{paymentId} {
      allow get: if isAdmin() && isValidId(paymentId);
      allow list: if isAdmin() && resource.data.provider == 'razorpay';
      allow create: if isAdmin() && isValidId(paymentId) && isValidPaymentRecord(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/appointments/$(incoming().appointment_id));
      allow update: if isAdmin() && isValidId(paymentId) && isValidPaymentRecord(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().appointment_id == existing().appointment_id &&
        incoming().amount == existing().amount &&
        incoming().currency == existing().currency &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'provider_payment_id',
          'payment_status',
          'updatedAt'
        ]);
      allow delete: if false;
    }
  }
}
